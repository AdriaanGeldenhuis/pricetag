# Application
APP_NAME=Pricetag
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pricetag.co.za
APP_KEY=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pricetag
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE=true

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@pricetag.co.za
MAIL_FROM_NAME="${APP_NAME}"

# Payment - Yoco
YOCO_PUBLIC_KEY=
YOCO_SECRET_KEY=
YOCO_SANDBOX=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_RATE_LIMIT=10

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=pricetag_
CACHE_TTL=3600

# Security
ADMIN_IP_WHITELIST=
CSRF_TOKEN_LIFETIME=3600
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# CDN (optional)
CDN_URL=
CDN_ENABLED=false
