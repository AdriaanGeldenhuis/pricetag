# Copy this to .env.test to run the integration test suite against a
# dedicated test database. Tests wrap each method in a transaction that
# is rolled back, so fixtures don't accumulate.
#
# Without .env.test the suite still runs all pure-unit tests and skips
# anything that needs a DB connection (no failure, no false positives).

APP_NAME=Pricetag Tests
APP_ENV=testing
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pricetag_test
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
